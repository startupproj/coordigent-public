{
  "name": "coordigent",
  "version": "0.1.3",
  "description": "Coordigent's coord and coord-mcp commands: downloads the binaries for this machine on first run, checks their SHA-256, and runs them. `npx coordigent` and `npx coordigent mcp` work too.",
  "homepage": "https://coordigent.com",
  "license": "MIT",
  "mcpName": "com.coordigent/coordigent",
  "keywords": [
    "mcp",
    "mcp-server",
    "coding-agents",
    "multi-agent",
    "claude-code",
    "codex",
    "cursor",
    "coordination",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startupproj/coordigent-public.git",
    "directory": "npm"
  },
  "bin": {
    "coord": "bin/coord.js",
    "coord-mcp": "bin/coord-mcp.js",
    "coordigent": "bin/coordigent.js"
  },
  "files": [
    "bin/coord.js",
    "bin/coord-mcp.js",
    "bin/coordigent.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
