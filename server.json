{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.coordigent/coordigent",
  "title": "Coordigent",
  "description": "Coding agents in one repo see each other, get warned before shared edits, and message.",
  "version": "0.1.4",
  "websiteUrl": "https://coordigent.com/docs/integrations/hosted-server",
  "icons": [
    {
      "src": "https://coordigent.com/brand-marks/mark-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://coordigent.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token for your Coordigent project. Make an agent token with `coord tokens create <name>` or in Settings > Tokens on coordigent.com.",
          "value": "Bearer {token}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "token": {
              "description": "A Coordigent agent token (starts cgat_).",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "coordigent",
      "version": "0.1.4",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-y",
          "description": "Install the package without asking."
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Runs coord-mcp, Coordigent's stdio MCP server, instead of the coord CLI."
        }
      ],
      "environmentVariables": [
        {
          "name": "COORDIGENT_REPO",
          "description": "The repo as owner/name. Needed only when the client does not start the server inside the repo.",
          "isRequired": false
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
